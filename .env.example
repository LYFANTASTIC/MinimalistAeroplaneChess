# Supabase Singapore PostgreSQL. Prefer direct IPv6 for a persistent backend;
# use Supavisor Session mode (port 5432) when the host is IPv4-only.
DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Only used by the one-time JSON account importer.
USER_DATA_FILE=backend/data/users.json

# Existing server settings.
PORT=3000
